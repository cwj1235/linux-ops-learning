# 自动识别文本文件
* text=auto

# 项目文档和配置统一使用 Linux 的 LF 换行
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.service text eol=lf
*.sh text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
